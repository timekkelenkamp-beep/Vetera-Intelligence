# Kopieer naar backend/.env en vul aan. Dit bestand blijft lokaal en wordt nooit naar de browser gestuurd.
# Optioneel: zonder sleutel werken alle basisfuncties (handmatige invoer, import, vergelijking, rapportage).
ANTHROPIC_API_KEY=

# Lokale server (standaard alleen bereikbaar vanaf deze computer)
VETERA_HOST=127.0.0.1
VETERA_PORT=3000

# Optioneel andere datamap (database, documenten, imports, logo's, rapporten, back-ups)
# VETERA_DATA_DIR=C:\VeteraData

# Maximale uploadgrootte in MB
VETERA_MAX_UPLOAD_MB=50
